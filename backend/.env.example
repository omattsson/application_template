# Application Configuration
APP_NAME=application
APP_ENV=development
APP_DEBUG=true
# Product name shown by the web UI (GET /api/v1/ui-config). Default: Application Template
APP_TITLE=Application Template
# Authentication switch (true/false, default false). With false the API is open.
# With true, startup fails unless JWT_SECRET is set and at least 16 characters.
AUTH_ENABLED=false
# HMAC key for access tokens. NO DEFAULT: generate your own, for example
#   openssl rand -base64 48
# Never reuse a value from a document, an example or another environment.
# Required (16+ characters) when AUTH_ENABLED=true; ignored when it is false.
JWT_SECRET=
# Lifetime of a token issued outside a refresh session (default 24h)
# JWT_EXPIRATION=24h
# Lifetime of the access token of a login session (default 15m)
# ACCESS_TOKEN_EXPIRATION=15m
# A session with no activity for this long ends (default 30m, at most SESSION_MAX_LIFETIME)
# SESSION_IDLE_TIMEOUT=30m
# Absolute session lifetime (default 12h)
# SESSION_MAX_LIFETIME=12h
# Lifetime of one refresh token (default 168h). The session deadline
# (SESSION_MAX_LIFETIME after login) caps it, so refreshing never extends a session.
# REFRESH_TOKEN_EXPIRATION=168h
# A refresh token rotated less than this long ago gets one more access token,
# once (two tabs refreshing at the same time). Any other reuse of a used
# refresh token ends the session. Default 30s, 0 turns it off, at most 5m.
# REFRESH_REUSE_GRACE=30s
# Secure attribute of the refresh token cookie (true/false, default true): the
# browser sends it over HTTPS only. Browsers accept it on http://localhost; set
# false only for plain-HTTP development on another host name.
# SECURE_COOKIES=true
# Username of the first admin (default admin)
# ADMIN_USERNAME=admin
# Password of the first admin. NO DEFAULT: when empty no admin user is created.
# With AUTH_ENABLED=true a set value must be 8 to 72 bytes, or startup fails.
# The admin is created once; a later change of this value does not change it.
# ADMIN_PASSWORD=
# Let anyone create a local account (true/false, default false)
# SELF_REGISTRATION=false
# Where the token blocklist and the OIDC login states live: mysql (default, the
# shared database; every replica sees every logout) or memory (one process only,
# development; a restart forgets every revocation). Another value fails startup
# when AUTH_ENABLED=true.
# SESSION_STORE=mysql

# OpenID Connect (OIDC) single sign-on. Off by default. It needs AUTH_ENABLED=true
# and refresh sessions; with AUTH_ENABLED=false the OIDC routes answer 404.
# With both on, startup fails (without printing the secret) when the issuer, client id,
# client secret or redirect URL is missing or malformed.
# OIDC_ENABLED=false
# Issuer URL of the identity provider. Must be https. Compared exactly with the
# issuer of the discovery document and of every ID token (mind a trailing slash).
# OIDC_ISSUER=https://idp.example.com/realms/app
# OIDC_CLIENT_ID=application
# NO DEFAULT: the client secret registered at the provider. Never commit it.
# OIDC_CLIENT_SECRET=
# Callback URL registered at the provider (https; http only for localhost):
#   <public URL of the app>/api/v1/auth/oidc/callback
# OIDC_REDIRECT_URL=https://app.example.com/api/v1/auth/oidc/callback
# Scopes (comma or space separated, must include openid). Default: openid,profile,email
# OIDC_SCOPES=openid,profile,email
# ID token claim with the roles or groups of the user (a string or a list). Default: roles
# OIDC_ROLE_CLAIM=roles
# Role names (exact, case-sensitive, comma separated) that make an OIDC user an admin or a
# devops user. Empty (the default): nobody gets that role through OIDC. The role of an OIDC
# user is set from the claim at every login, so a demotion at the provider applies.
# OIDC_ADMIN_ROLES=
# OIDC_DEVOPS_ROLES=
# Keep the password login open to every local user while OIDC is on (true/false, default
# false: only service accounts such as the bootstrap admin may use a password).
# OIDC_LOCAL_AUTH=false
# How long a started login stays valid (30s to 1h, default 5m).
# OIDC_STATE_TTL=5m
# Path of the web UI that the callback redirects to after a login (default /auth/callback).
# The web UI then calls POST /api/v1/auth/refresh for its access token.
# OIDC_FRONTEND_PATH=/auth/callback

# Database Configuration
# Use 'db' as host when running in Docker Compose, 'localhost' for local dev
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=app
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Server Configuration
SERVER_HOST=0.0.0.0
PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s
# Comma-separated IPs or CIDR ranges of reverse proxies allowed to set the client IP
# via X-Forwarded-For / X-Real-IP (e.g. 10.0.0.0/8,192.168.1.10). Empty trusts no proxy.
# 0.0.0.0/0, ::/0 and IPv4-mapped IPv6 entries are refused at startup.
# Pitfall: behind a proxy with an empty list, every request has the proxy's IP, so
# all users share ONE rate-limit bucket (RATE_LIMIT requests and LOGIN_RATE_LIMIT
# logins per minute in total). docker-compose.yml defaults this to the frontend
# proxy (nginx / Vite) at FRONTEND_PROXY_IP=172.30.80.10. List only proxy addresses,
# not a whole network: a trusted network gateway lets a client pick its IP.
TRUSTED_PROXIES=
# Requests per minute per client IP (docker-compose default: 100)
RATE_LIMIT=100
# Login attempts per minute per client IP (docker-compose default: 10)
LOGIN_RATE_LIMIT=10
# Serve the Swagger UI (true/false)
ENABLE_SWAGGER=false

# Logging Configuration
# One of: debug, info, warn, error. An invalid value stops startup.
LOG_LEVEL=info
LOG_FILE=

# Gin mode: APP_DEBUG=true -> debug, APP_DEBUG=false -> release. GIN_MODE, when set, wins.
# GIN_MODE=release

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=300
