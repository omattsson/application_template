# Backend configuration. There are two copies that differ in the DB_HOST line
# only: backend/.env.example (DB_HOST=db, for a backend inside Docker Compose)
# and backend/config/.env.example (DB_HOST=localhost, for a backend that runs on
# the host). Copy the one that fits to backend/.env (it is not committed) or
# set the variables in the environment. This file is not a shell script: write
# values literally, never $(...) or a <placeholder>. A variable that is already set in the
# process environment wins over the same name in the file (godotenv does not
# override). Every variable the backend reads is listed here, with its default
# from internal/config; scripts/check-env-docs.sh (make check-env-docs) fails
# when this file, backend/config/.env.example or docs/claude/operations.md and
# the code disagree. The two example files differ in the DB_HOST line only.
#
# Lines that start with "# NAME=" show the default (or an example); remove the
# "# " to change the value. DEV ONLY marks a value that is for a local
# development database or a test run and must never be used in production.

# --- Application -------------------------------------------------------------

# Path of the dotenv file to load. Default: .env in the working directory (a
# missing file is fine).
# ENV_FILE=.env
# Application name. Default: backend-api
# APP_NAME=backend-api
# Environment label. Default: development. The backend only requires a value;
# nothing branches on it. (Compose uses a variable of the same name to choose
# the image target.)
# GO_ENV=development
# Product name that the web UI shows (GET /api/v1/ui-config). Default: Application Template
# APP_TITLE=Application Template
# Gin mode and SQL logging: true is Gin debug mode and SQL values in the log,
# false is release mode and redacted SQL. Default: true. Set false in production.
# APP_DEBUG=true
# Gin mode. When set it wins over APP_DEBUG (debug, release or test). Default: not set.
# GIN_MODE=release

# --- Authentication ----------------------------------------------------------

# Authentication switch (true or false). Default: false, the API is open and the
# auth, API key, user and audit log routes do not exist. A value that is set but
# not a boolean stops the start. With true, JWT_SECRET is required (16 or more
# characters) and the other auth settings are validated.
# AUTH_ENABLED=false
# HMAC key of the access tokens. NO DEFAULT. Generate it, for example with
#   openssl rand -base64 48
# Never reuse a value from a document, an example or another environment.
# Required with AUTH_ENABLED=true; ignored with false.
# JWT_SECRET=
# Username of the bootstrap admin (the break-glass account). Default: admin.
# Use a name that is not "admin": a known name lets anyone lock the account
# for 15 minutes with 5 wrong passwords (the lock is in memory, per replica).
# ADMIN_USERNAME=admin
# Password of the bootstrap admin. NO DEFAULT: when empty, no admin user is
# created. With AUTH_ENABLED=true a set value must have 8 or more characters and
# at most 72 bytes, or the start fails. The admin is created once; a later
# change of this value changes nothing. Use a strong, unique password.
# ADMIN_PASSWORD=
# Let anyone create a local account with the role user (true or false).
# Default: false.
# SELF_REGISTRATION=false
# Secure attribute of the refresh token and OIDC binding cookies (true or false).
# Default: true. The cookies then get the __Host- name prefix and the browser
# sends them over HTTPS only. Chromium accepts them on http://localhost (the
# e2e run checks it). Set false only for plain-HTTP development on another host
# name, never in production. With AUTH_ENABLED=true a value that is not a
# boolean stops the start.
# SECURE_COOKIES=true

# --- Sessions and tokens (used with AUTH_ENABLED=true) -------------------------

# Lifetime of a token issued outside a refresh session. Default: 24h
# JWT_EXPIRATION=24h
# Lifetime of the access token of a login session. Default: 15m. Must be shorter
# than SESSION_IDLE_TIMEOUT.
# ACCESS_TOKEN_EXPIRATION=15m
# A session with no login or refresh for this long ends. Default: 30m. At most
# SESSION_MAX_LIFETIME.
# SESSION_IDLE_TIMEOUT=30m
# Absolute lifetime of a session. Refreshing never extends it. Default: 12h
# SESSION_MAX_LIFETIME=12h
# Lifetime of one refresh token. Default: 168h. The session deadline
# (SESSION_MAX_LIFETIME after the login) caps it.
# REFRESH_TOKEN_EXPIRATION=168h
# A refresh token that a rotation consumed less than this long ago gets one more
# access token (two tabs that refresh at the same time). Any other reuse of a
# consumed token ends the session. Default: 30s. 0 turns it off. At most 5m.
# REFRESH_REUSE_GRACE=30s
# Where the token blocklist and the OIDC login states live: mysql (default: the
# shared database, every replica sees every logout) or memory (this process only,
# for one replica in development: a restart forgets every revocation). Another
# value stops the start.
# SESSION_STORE=mysql

# --- OpenID Connect single sign-on (needs AUTH_ENABLED=true) -------------------

# Off by default. With AUTH_ENABLED=false the OIDC routes answer 404 and these
# settings are not validated. With both on, the start fails (without printing a
# secret) when a required value is missing or malformed.
# OIDC_ENABLED=false
# Issuer URL of the identity provider. Must be https, without credentials, query
# or fragment. Compared exactly with the issuer of the discovery document and of
# every ID token (mind a trailing slash).
# OIDC_ISSUER=https://idp.example.com/realms/app
# Client ID registered at the provider.
# OIDC_CLIENT_ID=application
# Client secret registered at the provider. NO DEFAULT. Never commit it.
# OIDC_CLIENT_SECRET=
# Callback URL registered at the provider (https; http only for localhost). With
# the bundled nginx and the Vite dev server in front, the public callback is
#   <origin>/api/api/v1/auth/oidc/callback
# because both proxies strip one /api. Without a proxy it is
# <origin>/api/v1/auth/oidc/callback. The backend does not check the value
# against the proxy: a wrong path fails at the provider, not here.
# OIDC_REDIRECT_URL=https://app.example.com/api/api/v1/auth/oidc/callback
# Scopes, comma or space separated, must include openid. Default: openid,profile,email
# OIDC_SCOPES=openid,profile,email
# ID token claim with the roles or groups of the user: a top-level claim, a
# string or a list of strings (at most 200 values are read). Default: roles
# OIDC_ROLE_CLAIM=roles
# Role names (exact, case-sensitive, comma or space separated) that make an OIDC
# user an admin or a devops user. Empty (the default): nobody gets that role
# through OIDC. The role of an OIDC user is set from the claim at every login.
# OIDC_ADMIN_ROLES=
# OIDC_DEVOPS_ROLES=
# Keep the password login open to every local user while OIDC is on (true or
# false). Default: false: only service accounts, such as the bootstrap admin,
# may sign in with a password.
# OIDC_LOCAL_AUTH=false
# How long a started login stays valid, 30s to 1h. Default: 5m
# OIDC_STATE_TTL=5m
# Path of the web UI that the callback redirects to after a login. Default:
# /auth/callback. The web UI then calls POST /api/v1/auth/refresh for its token.
# OIDC_FRONTEND_PATH=/auth/callback

# --- Database (MySQL 8.0.17 or later) -----------------------------------------

# Database backend. mysql is the default and the only value for a running
# backend; sqlite exists for unit tests.
# DB_TYPE=mysql
# Host name. Default: localhost. Use "db" inside Docker Compose, localhost for a
# backend on the host.
DB_HOST=localhost
# DB_PORT=3306
# DEV ONLY: the user and password of the Compose development database. Compose
# creates the user with the MYSQL_PASSWORD it is given (default apppass). The
# code defaults are user root and an empty password.
DB_USER=appuser
DB_PASSWORD=apppass
# DB_NAME=app
# Pool size. Defaults: 25 open, 5 idle.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# Longest age of a pooled connection. Default: 5m
# DB_CONN_MAX_LIFETIME=5m

# --- Server ------------------------------------------------------------------

# Address to listen on. Default: empty (all interfaces) and port 8081. The
# Docker images and the proxies expect 8081.
# SERVER_HOST=
# SERVER_PORT=8081
# HTTP timeouts. Defaults: read 10s, write 0 (off), idle 30s. A write timeout
# of 0 keeps idle WebSocket connections open; set a positive value only after
# reading internal/config/config.go.
# SERVER_READ_TIMEOUT=10s
# SERVER_WRITE_TIMEOUT=0s
# SERVER_IDLE_TIMEOUT=30s
# Budget of each shutdown step. Default: 30s (5s when set to 0). The worst case
# is five steps, so the stop grace period of the orchestrator must be longer
# than five times this value (docker-compose.yml: 170s for the default).
# SERVER_SHUTDOWN_TIMEOUT=30s
# Comma-separated IPs or CIDR ranges of reverse proxies that may set the client
# IP with X-Forwarded-For or X-Real-IP, for example 10.0.0.0/8,192.168.1.10.
# Default: empty, no proxy is trusted and the client IP is the TCP peer.
# 0.0.0.0/0, ::/0 and IPv4-mapped IPv6 entries are refused at startup. Behind a
# proxy with an empty list every request has the proxy's IP, so all users share
# ONE rate-limit bucket. docker-compose.yml sets this to the frontend proxy
# (FRONTEND_PROXY_IP, 172.30.80.10); an empty value there means that default,
# so it cannot be emptied through Compose. List proxy addresses, not a network.
# TRUSTED_PROXIES=
# Requests per minute per client IP on /api/v1. Default: 100. Must be positive.
# RATE_LIMIT=100
# Login, register and OIDC attempts per minute per client IP (each route its
# own budget). Default: 10. Must be positive.
# LOGIN_RATE_LIMIT=10
# Serve the Swagger UI at /swagger/index.html (true or false). Default: false.
# With AUTH_ENABLED=true the page stays open without a login.
# ENABLE_SWAGGER=false

# --- Logging -----------------------------------------------------------------

# One of debug, info, warn (or warning), error. Default: info. An invalid value
# stops the start.
# LOG_LEVEL=info
# Read into the configuration but not used: logs go to stderr. Default: empty.
# LOG_FILE=

# --- CORS --------------------------------------------------------------------

# Allowed origins: "*" or a comma-separated list such as
# https://app.example.com,https://admin.example.com. Default: *. Allowing every
# origin is for development only. The same list gates the WebSocket Origin
# header. The bundled web UI is same-origin and needs no entry. Allowed methods
# and headers are fixed in code (middleware.CORS); no other CORS variable is read.
# CORS_ALLOWED_ORIGINS=*

# --- Telemetry ---------------------------------------------------------------

# OpenTelemetry traces, metrics and logs sent to an OTLP collector (gRPC), true
# or false. Default: false. With false nothing is created: no exporter, no
# goroutine, no extra work per request. A value that is not a boolean stops the
# start. The connection to the collector is NOT encrypted: use a collector on a
# trusted network (a sidecar or a service on the same private network). Spans carry the
# authenticated user's ID, username and role.
# OTEL_ENABLED=false
# Collector address: host:port, or the URL form http://host:port (the scheme is
# dropped). Default: localhost:4317. Read only with OTEL_ENABLED=true. https://
# stops the start (the connection cannot be encrypted); so does a path, query or
# credentials. A collector that is not on this host (not localhost, 127.0.0.1 or
# ::1) logs a warning at startup: the export is plaintext.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# service.name of every span, metric and log record. Default: backend-api. Read
# only with OTEL_ENABLED=true.
# OTEL_SERVICE_NAME=backend-api
# Share of new traces that are recorded, 0 to 1. Default: 1. A request that
# arrives with a sampled traceparent is always recorded. Read only with
# OTEL_ENABLED=true; a value outside 0 to 1 stops the start.
# OTEL_TRACE_SAMPLE_RATE=1
# Record request metrics (http.server.request.*) and build the Prometheus
# handler (Telemetry.MetricsHandler), also without OTEL_ENABLED. true or false.
# Default: false. A value that is not a boolean stops the start. With true the
# backend serves GET /metrics (Prometheus text format) on METRICS_ADDR, a port
# of its own: the API router never serves it.
# METRICS_ENABLED=false
# Address of the metrics server, host:port. Default: :9090 (all interfaces). The
# endpoint has NO authentication and exposes route names, status codes and Go
# runtime figures: keep the port on a private network (a Compose network, a
# an internal service of the platform), never publish it to the internet. Read only with
# METRICS_ENABLED=true; an invalid address stops the start. If the port cannot
# be bound the error is logged and the API starts without metrics.
# METRICS_ADDR=:9090

# --- Profiling (pprof) -------------------------------------------------------

# Serve net/http/pprof on a port of its own (never the API port), true or
# false. Default: false. A heap or goroutine dump exposes secrets (tokens, keys,
# request data): leave it off in production, and when you need it, use it from
# the host with a port-forward or a tunnel. A value that is not a boolean stops
# the start.
# PPROF_ENABLED=false
# Address of the pprof server, host:port. Default: 127.0.0.1:6060 (loopback
# only). With PPROF_ENABLED=true an address that is not loopback (localhost,
# 127.x.x.x or ::1) stops the start unless PPROF_ALLOW_NON_LOOPBACK=true. Read
# only with PPROF_ENABLED=true.
# PPROF_ADDR=127.0.0.1:6060
# Allow a PPROF_ADDR that is not loopback (true or false). Default: false. Needed
# for a container that publishes the port to the host (bind 0.0.0.0 inside, and
# publish it on 127.0.0.1 of the host only). The backend then logs a warning at
# every start. Read only with PPROF_ENABLED=true.
# PPROF_ALLOW_NON_LOOPBACK=false
# runtime.SetMutexProfileFraction: on average 1 in N mutex contention events is
# profiled. Default: 0 (off). A whole number of 0 or more. Read only with
# PPROF_ENABLED=true.
# PPROF_MUTEX_FRACTION=0
# runtime.SetBlockProfileRate in nanoseconds: on average one blocking event per
# this many nanoseconds spent blocked is profiled (1 profiles every event).
# Default: 0 (off). A whole number of 0 or more. Read only with
# PPROF_ENABLED=true.
# PPROF_BLOCK_RATE=0
